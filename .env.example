# TripGraph — environment variables
# Copy this file to .env and fill in your credentials.
# The .env file is read by app/config.py via python-dotenv.
# NEVER commit .env to version control.

# ── Neo4j AuraDB ─────────────────────────────────────────────────────────────
# Get these from: https://console.neo4j.io  →  Your instance → Connect
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password-here

# ── Groq API ──────────────────────────────────────────────────────────────────
# Get your free key from: https://console.groq.com
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── OpenRouteService (optional — enables real driving ETAs) ──────────────────
# Get a free key from: https://openrouteservice.org/dev/#/signup
# Leave blank to use straight-line distance estimates instead.
ORS_API_KEY=
